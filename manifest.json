{
  "manifest_version": 3,
  "name": "Memoir: Browser Screen Time",
  "short_name": "Memoir",
  "version": "6.0.0",
  "version_name": "6.0.0",
  "description": "Quietly logs where your browsing time goes, keeps you to a daily limit, and shows your whole week at a glance.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "storage", "unlimitedStorage", "idle", "alarms", "notifications", "favicon"],
  "optional_permissions": ["nativeMessaging"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Memoir",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
